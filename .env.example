# ============================================================
# Bluprint Admin Dashboard — frontend env (Vite).
# Copy to `.env` and fill in. ONLY public values belong here:
# the Supabase URL + the *anon* (publishable) key. These are the
# SAME values the Bluprint app ships (EXPO_PUBLIC_SUPABASE_*).
#
# NEVER put the service-role key, RevenueCat secret key, or any
# other secret in this file or anywhere in the frontend — those
# live only as Supabase Edge Function secrets (server-side).
# See ../docs (MORNING-TODO.md, CHROME-PROMPTS.md).
# ============================================================

# Supabase project (ref: ljbkedvfaomfpjmwxbfm)
VITE_SUPABASE_URL=https://ljbkedvfaomfpjmwxbfm.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: override the Edge Functions base URL (defaults to
# `${VITE_SUPABASE_URL}/functions/v1`). Leave blank in normal use.
VITE_FUNCTIONS_URL=
